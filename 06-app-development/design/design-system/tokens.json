		"1": { "$value": "0 1px 2px rgba(17, 17, 17, 0.06), 0 8px 24px rgba(17, 17, 17, 0.06)", "$type": "shadow", "source": "measured", "$description": "悬浮卡片：很淡很散的阴影（近似值）" },
		"2": { "$value": "0 2px 4px rgba(17, 17, 17, 0.08), 0 16px 40px rgba(17, 17, 17, 0.10)", "$type": "shadow", "source": "proposed", "$description": "弹层、菜单" }
