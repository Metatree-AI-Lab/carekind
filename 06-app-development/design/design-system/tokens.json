		"size-heading": { "$value": "2rem", "$type": "dimension", "source": "proposed", "$description": "32px。页面标题" },
		"size-display-sm": { "$value": "2.5rem", "$type": "dimension", "source": "proposed", "$description": "40px。营销页小号大标题" },
