{
	"$description": "careKind AI design tokens：设计规范里**所有数值的唯一来源**。改这里，然后运行 scripts/build-design-system.sh 重新生成 tokens.css 和 DESIGN.md 里的表格。source 取值：measured = 从选定的参考图里实测；derived = 由实测值推导（为了满足 WCAG 2.2 AA）；proposed = 参考图里没有，我们提议的值，待 Lightman / Lin 确认。",
	"color": {
		"canvas": { "$value": "#E8E4DC", "$type": "color", "source": "measured", "$description": "页面最外层的暖米色背景" },
		"surface": { "$value": "#FFFFFF", "$type": "color", "source": "measured", "$description": "卡片、导航、输入框的底色" },
		"surface-subtle": { "$value": "#F5F5F5", "$type": "color", "source": "measured", "$description": "分区背景、分段控件的底" },
		"ink": { "$value": "#111111", "$type": "color", "source": "measured", "$description": "正文、主按钮底色、深色页脚" },
		"ink-soft": { "$value": "#5F5F5F", "$type": "color", "source": "derived", "$description": "次要文字（参考图的浅灰字对比度不足 AA，这里加深）" },
		"on-ink": { "$value": "#FFFFFF", "$type": "color", "source": "measured", "$description": "深色底上的文字" },
		"line": { "$value": "#DAD6CE", "$type": "color", "source": "derived", "$description": "装饰性分割线、卡片描边（不用于控件边界）" },
		"line-strong": { "$value": "#767676", "$type": "color", "source": "derived", "$description": "输入框、复选框等控件边界（与背景对比度 ≥ 3:1）" },
		"green": { "$value": "#00A84E", "$type": "color", "source": "measured", "$description": "强调色（大字、图形）；不能用于小号正文" },
		"green-soft": { "$value": "#42A572", "$type": "color", "source": "measured", "$description": "进度条填充等图形" },
		"green-ink": { "$value": "#007A3D", "$type": "color", "source": "derived", "$description": "绿色的文字 / 图标版本（成功状态）" },
		"blue": { "$value": "#45B1FF", "$type": "color", "source": "measured", "$description": "数据点、进度条；对比度不足 3:1，必须配文字或图案" },
		"blue-ink": { "$value": "#0B6BCB", "$type": "color", "source": "derived", "$description": "蓝色的文字 / 图标版本（信息状态、链接）" },
		"amber": { "$value": "#FDB43C", "$type": "color", "source": "measured", "$description": "状态小圆点；必须配文字" },
		"amber-ink": { "$value": "#8A5A00", "$type": "color", "source": "derived", "$description": "琥珀色的文字 / 图标版本（提醒状态）" },
		"purple": { "$value": "#A078F9", "$type": "color", "source": "measured", "$description": "AI 相关标记的装饰色" },
		"purple-ink": { "$value": "#5B3FC2", "$type": "color", "source": "derived", "$description": "AI 草稿标记的文字 / 图标版本" },
		"danger-ink": { "$value": "#C62828", "$type": "color", "source": "proposed", "$description": "错误与不可撤销操作（参考图里没有红色，这是我们提议的值）" },
		"green-tint": { "$value": "#E6F6EC", "$type": "color", "source": "derived", "$description": "成功状态的浅底" },
		"blue-tint": { "$value": "#E5F3FF", "$type": "color", "source": "derived", "$description": "信息状态的浅底" },
		"amber-tint": { "$value": "#FFF4DB", "$type": "color", "source": "derived", "$description": "提醒状态的浅底" },
		"purple-tint": { "$value": "#F1ECFF", "$type": "color", "source": "derived", "$description": "AI 内容的浅底（AI 新增 / 改写内容的高亮）" },
		"danger-tint": { "$value": "#FCEBEB", "$type": "color", "source": "proposed", "$description": "错误状态的浅底" },
		"overlay": { "$value": "rgba(17, 17, 17, 0.5)", "$type": "color", "source": "proposed", "$description": "弹窗背后的遮罩" }
